POSTGRES_DB=bg_company
POSTGRES_USER=bg_company
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://bg_company:change_me@localhost:5432/bg_company

AGENT_RUNNER_MODE=mock
AGENT_API_KEY=change_me
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_TIMEOUT_MS=30000
HERMES_HEALTH_PATH=/health
HERMES_RUN_PATH=/api/runs
HERMES_DAILY_RUN_LIMIT=20
HERMES_DAILY_RUN_TZ=Asia/Seoul

ADMIN_PASSWORD=change_me
AUTH_SESSION_SECRET=change_me

# Internal Hermes CLI bridge. Keep BRIDGE_API_KEY secret in production.
BRIDGE_API_KEY=change_me
HERMES_BRIDGE_BASE_URL=http://hermes-bridge:8787
HERMES_BRIDGE_TIMEOUT_MS=60000
HERMES_BRIDGE_HEALTH_TIMEOUT_MS=3000
HERMES_PLANNER_TIMEOUT_MS=60000
HERMES_MARKETING_TIMEOUT_MS=60000
HERMES_WRITER_TIMEOUT_MS=120000
HERMES_QA_TIMEOUT_MS=90000
HERMES_CLIENT_TIMEOUT_BUFFER_MS=15000
HERMES_BRIDGE_MAX_STDOUT_BYTES=200000
HERMES_BRIDGE_MAX_CONCURRENCY=1
HERMES_BRIDGE_MAX_MEMORY_PERCENT=80
HERMES_BRIDGE_PROVIDER=openai-api
HERMES_BRIDGE_MODEL=gpt-5.4-mini
OPENAI_API_KEY=
# Organization Owner가 발급한 Admin Key. 재정 화면의 공식 Costs/Usage 조회에만 사용합니다.
# 일반 프로젝트 API Key로 대체할 수 없으며 브라우저로 전달하지 않습니다.
OPENAI_ADMIN_KEY=
# 선택: 쉼표로 구분한 OpenAI project id만 집계합니다. 비우면 조직 전체입니다.
OPENAI_COST_PROJECT_IDS=
OPENAI_FINANCE_TIMEOUT_MS=15000
OPENAI_FINANCE_CACHE_MS=300000

# Naver Blog Local Draft Agent
NAVER_DRAFT_AGENT_KEY=change_me
NAVER_DRAFT_AUTO_AFTER_QA=false
# true: Director approval required before creating a local Naver draft job.
# false: allow draft job creation/auto-queue before approval. The local agent still never publishes.
NAVER_DRAFT_REQUIRE_APPROVAL=true
NAVER_DRAFT_POLL_INTERVAL_MS=30000
NAVER_DRAFT_MAX_CLAIM_MINUTES=10
# Retry only failures that occur before the final publish attempt.
NAVER_DRAFT_SAFE_RETRY_LIMIT=2

# Stock blog reference collection. Naver search is read-only and must never fall back to mock in Hermes mode.
STOCK_REFERENCE_PROVIDER=mock
STOCK_REFERENCE_MAX_RESULTS=5
STOCK_REFERENCE_MANUAL_PATH=config/stock-references/manual-references.json
STOCK_REFERENCE_MANUAL_JSON=
REFERENCE_SEARCH_PROVIDER=mock
REFERENCE_SEARCH_MAX_RESULTS=5
REFERENCE_SEARCH_ENABLE_REAL_API=false
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
COMPETITOR_BLOG_SEARCH_ENABLED=false
COMPETITOR_BLOG_SEEDS=주간증시,코스피전망,미국증시전망,다음주증시,장전브리핑
COMPETITOR_BLOG_DEEP_ANALYSIS_ENABLED=false
COMPETITOR_BLOG_DEEP_ANALYSIS_REQUIRED=false
# Analyze at most five pages sequentially to cap network and memory usage.
COMPETITOR_BLOG_DEEP_ANALYSIS_LIMIT=5
COMPETITOR_BLOG_DEEP_ANALYSIS_TIMEOUT_MS=10000
COMPETITOR_BLOG_DEEP_ANALYSIS_MAX_BYTES=750000
# Automatic read-only MarketSnapshot: KIS market data + FRED macro data.
# No order, balance, account or position API is allowed by the application.
STOCK_MARKET_DATA_PROVIDER=kis-fred
STOCK_MARKET_DATA_ALLOW_MANUAL_FALLBACK=false
# Defaults to enabled when omitted. Set false to make any unresolved FRED failure block article generation.
# Degraded mode still requires fresh KIS data and an official U.S. fallback source; unavailable values are omitted and disclosed.
STOCK_MARKET_DATA_ALLOW_FRED_DEGRADED=true
# Defaults to enabled when omitted. If only KIS sector rankings are empty, omit that section with disclosure.
# Core KOSPI/KOSDAQ, investor-flow, U.S. index, FX and FRED data must still be verified and fresh.
STOCK_MARKET_DATA_ALLOW_KIS_SECTOR_DEGRADED=true
STOCK_MARKET_DATA_ALLOW_MANUAL_IN_HERMES=false
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_TIMEOUT_MS=10000
KIS_MAX_RETRIES=2
KIS_RETRY_BASE_DELAY_MS=500
# Serialize read-only quote calls to avoid KIS EGW00201 per-second limits.
KIS_MIN_REQUEST_INTERVAL_MS=800
KIS_MARKET_MAX_AGE_MINUTES=4320
KIS_WEEKEND_MAX_AGE_MINUTES=5760
KIS_SP500_CODE=SPX
KIS_NASDAQ_CODE=COMP
KIS_DOW_CODE=.DJI
KIS_USD_KRW_CODE=FX@KRW
FRED_API_KEY=
FRED_TIMEOUT_MS=10000
FRED_MAX_AGE_MINUTES=7200
FRED_US_2Y_SERIES_ID=DGS2
FRED_US_10Y_SERIES_ID=DGS10
# Read-only official fallback when FRED is unavailable or incomplete.
OFFICIAL_US_DATA_TIMEOUT_MS=12000
US_TREASURY_MAX_AGE_MINUTES=7200
# Legacy generic API and emergency manual fallback. Disabled unless explicitly selected.
STOCK_MARKET_DATA_API_URL=
STOCK_MARKET_DATA_API_KEY=
STOCK_MARKET_SNAPSHOT_PATH=config/stock-references/market-snapshot.json
STOCK_MARKET_SNAPSHOT_JSON=
# Enable only after the Windows Local Naver Draft Agent is updated and browser-tested.
# The agent accepts only same-origin /generated/stock-blog/* assets and converts SVG thumbnails to PNG locally.
NAVER_ALLOW_DRAFT_SAVE=false
NAVER_ALLOW_IMAGE_UPLOAD=false
NAVER_ALLOW_PUBLISH=false

# Phase 2-P.1 Portfolio monitoring. Read-only; account holdings sync is optional and orders are never allowed.
PORTFOLIO_MONITORING_ENABLED=false
PORTFOLIO_PRICE_PROVIDER=mock
PORTFOLIO_ACCOUNT_SYNC_ENABLED=false
PORTFOLIO_ACCOUNT_SYNC_PROVIDER=none
PORTFOLIO_NEWS_ENABLED=false
PORTFOLIO_DIVIDEND_ENABLED=false
PORTFOLIO_REPORT_MODE=rules
PORTFOLIO_AUTO_REFRESH_ENABLED=false
PORTFOLIO_AUTO_REFRESH_CRON=
PORTFOLIO_ACCOUNT_AUTO_SYNC_ENABLED=false
PORTFOLIO_ACCOUNT_AUTO_SYNC_CRON=30 8 * * *
PORTFOLIO_ACCOUNT_AUTO_SYNC_TZ=Asia/Seoul
PORTFOLIO_ACCOUNT_AUTO_SYNC_RETRY_LIMIT=1
PORTFOLIO_DAILY_ASSISTANT_ENABLED=false
PORTFOLIO_DAILY_SNAPSHOT_ENABLED=false
PORTFOLIO_CHANGE_ATTRIBUTION_ENABLED=false
PORTFOLIO_DAILY_REPORT_MODE=rules
PORTFOLIO_DAILY_SNAPSHOT_RETENTION_DAYS=730
PORTFOLIO_DAILY_ALERT_PRICE_PERCENT=5
PORTFOLIO_DAILY_ALERT_SYNC_FAILURE=true
PORTFOLIO_MAX_SYMBOLS=50
PORTFOLIO_PRICE_CACHE_MINUTES=15

# Phase 2-T.1 Internal paper trading. No broker order API or live credential is used.
PORTFOLIO_PAPER_TRADING_ENABLED=true
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
PAPER_INITIAL_CAPITAL_KRW=10000000
PAPER_STRATEGY_VERSION=chart-lab-v3-forward
PAPER_RISK_PER_TRADE=0.005
PAPER_MAX_POSITION_PERCENT=0.10
PAPER_MAX_OPEN_POSITIONS=8
PAPER_MAX_NEW_POSITIONS_PER_DAY=3
PAPER_MAX_TOTAL_EXPOSURE_PERCENT=0.80
PAPER_SLIPPAGE_BPS=15
PAPER_COMMISSION_BPS=0.5
PAPER_MAX_ENTRY_GAP_PERCENT=8
PAPER_STALE_AFTER_HOURS=36
# Toss Securities official Open API read-only holdings sync.
# Keep Client ID/Secret only in the server environment. Full account numbers are never stored.
TOSSINVEST_CLIENT_ID=
TOSSINVEST_CLIENT_SECRET=
# Optional: required only when the official account list returns multiple BROKERAGE accounts.
TOSSINVEST_ACCOUNT_SEQ=
TOSSINVEST_ACCOUNT_LABEL=토스증권 실계좌

# Stock Blog Scheduler
# Keep disabled by default. VPS cron can POST /api/stock-blog/scheduler with x-bg-agent-key.
STOCK_BLOG_SCHEDULER_ENABLED=false
STOCK_BLOG_SCHEDULER_TZ=Asia/Seoul
STOCK_BLOG_SCHEDULER_RUNNER_MODE=mock
STOCK_BLOG_SCHEDULER_AUTO_APPROVE=false
STOCK_BLOG_SCHEDULER_AUTO_CREATE_DRAFT=false
STOCK_BLOG_SCHEDULER_AUTO_PUBLISH=false
STOCK_BLOG_FIRST_AUTO_PUBLISH_AT=2026-07-19T19:00:00+09:00
STOCK_BLOG_AUTO_PUBLISH_CANARY_LIMIT=1
STOCK_BLOG_AUTO_PUBLISH_RETRY_LIMIT=0
STOCK_BLOG_LARGE_CAP_EVENTS_ENABLED=false
# 국내 대형주 공시 감지(OpenDART, 선택). 키가 없으면 SEC 미국 대형주만 감지합니다.
DART_API_KEY=
# SEC 요청 정책 식별자. 운영 서비스명과 연락 가능한 도메인/이메일을 사용하세요.
SEC_EDGAR_USER_AGENT=BGCompany/1.0 bgcompanyoffice.cloud
# 쉼표로 감지 대상을 조정할 수 있습니다. 비우면 코드의 기본 대형주 목록을 사용합니다.
STOCK_BLOG_KR_LARGE_CAP_NAMES=
STOCK_BLOG_US_LARGE_CAP_SYMBOLS=
STOCK_BLOG_SCHEDULER_LOOKBACK_MINUTES=180
# Reference/data preflight attempts inside the lookback window.
STOCK_BLOG_SCHEDULER_MAX_RETRIES=12
STOCK_BLOG_SCHEDULER_RETRY_DELAY_MINUTES=10
