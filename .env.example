POSTGRES_DB=bg_company
POSTGRES_USER=bg_company
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://bg_company:change_me@localhost:5432/bg_company

AGENT_RUNNER_MODE=mock
AGENT_API_KEY=change_me
HERMES_BASE_URL=
HERMES_API_KEY=
HERMES_TIMEOUT_MS=30000
HERMES_HEALTH_PATH=/health
HERMES_RUN_PATH=/api/runs
HERMES_DAILY_RUN_LIMIT=20
HERMES_DAILY_RUN_TZ=Asia/Seoul

ADMIN_PASSWORD=change_me
AUTH_SESSION_SECRET=change_me

# Internal Hermes CLI bridge. Keep BRIDGE_API_KEY secret in production.
BRIDGE_API_KEY=change_me
HERMES_BRIDGE_BASE_URL=http://hermes-bridge:8787
HERMES_BRIDGE_TIMEOUT_MS=45000
HERMES_BRIDGE_MAX_STDOUT_BYTES=200000
HERMES_BRIDGE_MAX_CONCURRENCY=1
HERMES_BRIDGE_PROVIDER=openai-api
HERMES_BRIDGE_MODEL=gpt-5.4-mini
OPENAI_API_KEY=

# Naver Blog Local Draft Agent
NAVER_DRAFT_AGENT_KEY=change_me
NAVER_DRAFT_AUTO_AFTER_QA=false
# true: Director approval required before creating a local Naver draft job.
# false: allow draft job creation/auto-queue before approval. The local agent still never publishes.
NAVER_DRAFT_REQUIRE_APPROVAL=true
NAVER_DRAFT_POLL_INTERVAL_MS=30000
NAVER_DRAFT_MAX_CLAIM_MINUTES=10

# Stock blog reference collection. Naver search is read-only and must never fall back to mock in Hermes mode.
STOCK_REFERENCE_PROVIDER=mock
STOCK_REFERENCE_MAX_RESULTS=5
STOCK_REFERENCE_MANUAL_PATH=config/stock-references/manual-references.json
STOCK_REFERENCE_MANUAL_JSON=
REFERENCE_SEARCH_PROVIDER=mock
REFERENCE_SEARCH_MAX_RESULTS=5
REFERENCE_SEARCH_ENABLE_REAL_API=false
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
COMPETITOR_BLOG_SEARCH_ENABLED=false
COMPETITOR_BLOG_SEEDS=
# Automatic read-only MarketSnapshot: KIS market data + FRED macro data.
# No order, balance, account or position API is allowed by the application.
STOCK_MARKET_DATA_PROVIDER=kis-fred
STOCK_MARKET_DATA_ALLOW_MANUAL_FALLBACK=false
STOCK_MARKET_DATA_ALLOW_MANUAL_IN_HERMES=false
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_TIMEOUT_MS=10000
KIS_MARKET_MAX_AGE_MINUTES=4320
KIS_SP500_CODE=SPX
KIS_NASDAQ_CODE=COMP
KIS_DOW_CODE=.DJI
KIS_USD_KRW_CODE=FX@KRW
FRED_API_KEY=
FRED_TIMEOUT_MS=10000
FRED_MAX_AGE_MINUTES=7200
FRED_US_2Y_SERIES_ID=DGS2
FRED_US_10Y_SERIES_ID=DGS10
# Legacy generic API and emergency manual fallback. Disabled unless explicitly selected.
STOCK_MARKET_DATA_API_URL=
STOCK_MARKET_DATA_API_KEY=
STOCK_MARKET_SNAPSHOT_PATH=config/stock-references/market-snapshot.json
STOCK_MARKET_SNAPSHOT_JSON=
NAVER_ALLOW_IMAGE_UPLOAD=false

# Stock Blog Scheduler
# Keep disabled by default. VPS cron can POST /api/stock-blog/scheduler with x-bg-agent-key.
STOCK_BLOG_SCHEDULER_ENABLED=false
STOCK_BLOG_SCHEDULER_TZ=Asia/Seoul
STOCK_BLOG_SCHEDULER_RUNNER_MODE=mock
STOCK_BLOG_SCHEDULER_AUTO_APPROVE=false
STOCK_BLOG_SCHEDULER_AUTO_CREATE_DRAFT=false
STOCK_BLOG_SCHEDULER_LOOKBACK_MINUTES=180
