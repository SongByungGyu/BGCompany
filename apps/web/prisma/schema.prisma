generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Employee {
  id              String   @id
  displayName     String
  initial         String
  department      String
  role            String
  status          String
  currentTaskId   String?
  currentLocation String?
  model           String?
  currentCost     Decimal? @db.Decimal(10, 4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tasks     Task[]
  approvals ApprovalRequest[]
  events    EventLog[]
  agentRuns AgentRun[]

  @@index([status])
  @@index([department])
}

model Task {
  id                 String    @id
  title              String
  description        String?
  department         String
  assignedEmployeeId String?
  status             String
  progress           Int       @default(0)
  startedAt          DateTime?
  completedAt        DateTime?
  model              String?
  cost               Decimal?  @db.Decimal(10, 4)
  currentStep        String?
  recentOutput       String?
  nextAction         String?
  error              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignedEmployee Employee?         @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  approvals        ApprovalRequest[]
  events           EventLog[]
  agentRuns        AgentRun[]

  @@index([status])
  @@index([department])
  @@index([assignedEmployeeId])
}

model ApprovalRequest {
  id                    String    @id
  title                 String
  requestedByEmployeeId String
  taskId                String?
  approvalType          String
  riskLevel             String
  estimatedCost         Decimal?  @db.Decimal(10, 4)
  status                String
  reason                String?
  plannedAction         String?
  expectedResult        String?
  decision              String?
  decisionReason        String?
  decidedAt             DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  requestedBy Employee   @relation(fields: [requestedByEmployeeId], references: [id], onDelete: Cascade)
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  events      EventLog[]

  @@index([status])
  @@index([requestedByEmployeeId])
  @@index([taskId])
}

model EventLog {
  id         String   @id
  type       String
  timestamp  DateTime @default(now())
  employeeId String?
  taskId     String?
  approvalId String?
  payload    Json
  summary    String?

  employee  Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  task      Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  approval  ApprovalRequest? @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  timelines Timeline[]

  @@index([type])
  @@index([timestamp])
  @@index([employeeId])
  @@index([taskId])
  @@index([approvalId])
}

model Timeline {
  id          String   @id
  targetType  String
  targetId    String
  eventId     String?
  title       String
  description String?
  timestamp   DateTime @default(now())

  event EventLog? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([timestamp])
}

model AgentRun {
  id            String    @id @default(cuid())
  taskId        String?
  employeeId    String
  mode          String
  status        String
  triggerSource String
  startedAt     DateTime?
  completedAt   DateTime?
  resultSummary String?
  errorMessage  String?
  hermesJobId   String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  task     Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([employeeId])
  @@index([status])
  @@index([createdAt])
  @@index([hermesJobId])
}

model NaverDraftJob {
  id                  String    @id @default(cuid())
  contentPipelineId   String?
  stockBlogContentId  String?
  approvalId          String?
  status              String
  title               String
  body                String
  markdownBody        String?
  htmlBody            String?
  tags                String[]
  category            String?
  thumbnailText       String?
  thumbnailPrompt     String?
  disclaimer          String?
  externalUrl         String?
  allowPublish        Boolean   @default(false)
  publishKey          String?   @unique
  marketDate          String?
  scheduleSlot        String?
  publishedAt         DateTime?
  publishedUrl        String?
  naverPostId         String?
  publishAttemptCount Int       @default(0)
  publishMethod       String?
  errorCode           String?
  errorMessage        String?
  claimedBy           String?
  claimedAt           DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([contentPipelineId])
  @@index([publishedAt])
  @@index([approvalId])
  @@index([claimedBy])
  @@index([createdAt])
}

model PortfolioAccount {
  id                 String    @id @default(cuid())
  name               String
  baseCurrency       String    @default("KRW")
  description        String?
  source             String    @default("manual")
  externalAccountRef String?
  lastSyncedAt       DateTime?
  lastSyncStatus     String?
  lastSyncMessage    String?
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  holdings                     PortfolioHolding[]
  valuations                   PortfolioValuationSnapshot[]
  riskSignals                  PortfolioRiskSignal[]
  reports                      PortfolioReport[]
  holdingChanges               PortfolioHoldingChange[]
  dailySnapshots               PortfolioDailySnapshot[]
  dailyBriefings               PortfolioDailyBriefing[]
  portfolioDailyHoldingChanges PortfolioDailyHoldingChange[]

  @@index([source, externalAccountRef])
  @@index([isActive])
  @@index([createdAt])
}

model PortfolioHolding {
  id                      String    @id @default(cuid())
  portfolioAccountId      String
  market                  String
  symbol                  String
  name                    String
  assetType               String
  quantity                Decimal   @db.Decimal(28, 8)
  averagePrice            Decimal   @db.Decimal(28, 8)
  currency                String
  sector                  String
  note                    String?
  source                  String    @default("manual")
  lastSyncedAt            DateTime?
  dividendTrackingEnabled Boolean   @default(false)
  isActive                Boolean   @default(true)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  portfolioAccount PortfolioAccount                @relation(fields: [portfolioAccountId], references: [id], onDelete: Restrict)
  riskSignals      PortfolioRiskSignal[]
  changes          PortfolioHoldingChange[]
  dailySnapshots   PortfolioHoldingDailySnapshot[]
  dailyChanges     PortfolioDailyHoldingChange[]
  attributions     PortfolioChangeAttribution[]

  @@unique([portfolioAccountId, market, symbol])
  @@index([portfolioAccountId, isActive])
  @@index([market, symbol])
}

model PortfolioHoldingChange {
  id                 String   @id @default(cuid())
  portfolioAccountId String
  holdingId          String
  changeType         String
  before             Json?
  after              Json
  createdAt          DateTime @default(now())

  portfolioAccount PortfolioAccount @relation(fields: [portfolioAccountId], references: [id], onDelete: Restrict)
  holding          PortfolioHolding @relation(fields: [holdingId], references: [id], onDelete: Restrict)

  @@index([holdingId, createdAt])
  @@index([portfolioAccountId, createdAt])
}

model PortfolioPriceSnapshot {
  id                  String   @id @default(cuid())
  market              String
  symbol              String
  price               Decimal  @db.Decimal(28, 8)
  currency            String
  change              Decimal? @db.Decimal(28, 8)
  changePercent       Decimal? @db.Decimal(12, 6)
  weeklyChangePercent Decimal? @db.Decimal(12, 6)
  marketDate          DateTime
  observedAt          DateTime
  collectedAt         DateTime @default(now())
  provider            String
  sourceUrl           String?
  freshnessStatus     String

  @@index([market, symbol, collectedAt])
  @@index([freshnessStatus])
}

model PortfolioValuationSnapshot {
  id                 String   @id @default(cuid())
  portfolioAccountId String
  evaluatedAt        DateTime @default(now())
  baseCurrency       String
  totalMarketValue   Decimal  @db.Decimal(28, 8)
  totalCostBasis     Decimal  @db.Decimal(28, 8)
  totalProfitLoss    Decimal  @db.Decimal(28, 8)
  totalReturnPercent Decimal  @db.Decimal(12, 6)
  exchangeRate       Decimal? @db.Decimal(18, 8)
  dataQuality        String
  missingItems       Json

  portfolioAccount PortfolioAccount @relation(fields: [portfolioAccountId], references: [id], onDelete: Restrict)

  @@index([portfolioAccountId, evaluatedAt])
}

model PortfolioDailySnapshot {
  id                        String    @id @default(cuid())
  portfolioAccountId        String
  marketDate                DateTime  @db.Date
  timezone                  String
  sourceSyncRunId           String    @unique
  capturedAt                DateTime  @default(now())
  baseCurrency              String
  totalMarketValue          Decimal   @db.Decimal(28, 8)
  totalCostBasis            Decimal   @db.Decimal(28, 8)
  totalUnrealizedProfitLoss Decimal   @db.Decimal(28, 8)
  totalReturnPercent        Decimal   @db.Decimal(12, 6)
  exchangeRate              Decimal?  @db.Decimal(18, 8)
  exchangeRateObservedAt    DateTime?
  holdingCount              Int
  status                    String
  dataQuality               String
  freshnessStatus           String
  missingItems              Json
  isPrimary                 Boolean   @default(true)
  createdAt                 DateTime  @default(now())

  portfolioAccount PortfolioAccount                @relation(fields: [portfolioAccountId], references: [id], onDelete: Restrict)
  holdings         PortfolioHoldingDailySnapshot[]
  currentChanges   PortfolioDailyHoldingChange[]   @relation("CurrentDailySnapshotChanges")
  previousChanges  PortfolioDailyHoldingChange[]   @relation("PreviousDailySnapshotChanges")
  currentEffects   PortfolioChangeAttribution[]    @relation("CurrentDailySnapshotEffects")
  previousEffects  PortfolioChangeAttribution[]    @relation("PreviousDailySnapshotEffects")
  briefing         PortfolioDailyBriefing?         @relation("DailySnapshotBriefing")
  comparedBy       PortfolioDailyBriefing[]        @relation("PreviousDailySnapshotBriefings")

  @@index([portfolioAccountId, marketDate, isPrimary])
  @@index([portfolioAccountId, capturedAt])
  @@index([status])
}

model PortfolioHoldingDailySnapshot {
  id                   String    @id @default(cuid())
  dailySnapshotId      String
  holdingId            String
  market               String
  symbol               String
  name                 String
  quantity             Decimal   @db.Decimal(28, 8)
  averagePrice         Decimal   @db.Decimal(28, 8)
  currentPrice         Decimal?  @db.Decimal(28, 8)
  dailyChangePercent   Decimal?  @db.Decimal(12, 6)
  currency             String
  exchangeRate         Decimal?  @db.Decimal(18, 8)
  marketValue          Decimal?  @db.Decimal(28, 8)
  costBasis            Decimal?  @db.Decimal(28, 8)
  unrealizedProfitLoss Decimal?  @db.Decimal(28, 8)
  returnPercent        Decimal?  @db.Decimal(12, 6)
  weightPercent        Decimal?  @db.Decimal(12, 6)
  priceObservedAt      DateTime?
  freshnessStatus      String
  createdAt            DateTime  @default(now())

  dailySnapshot PortfolioDailySnapshot @relation(fields: [dailySnapshotId], references: [id], onDelete: Cascade)
  holding       PortfolioHolding       @relation(fields: [holdingId], references: [id], onDelete: Restrict)

  @@unique([dailySnapshotId, holdingId])
  @@index([holdingId, createdAt])
  @@index([market, symbol])
}

model PortfolioDailyHoldingChange {
  id                   String   @id @default(cuid())
  portfolioAccountId   String
  currentSnapshotId    String
  previousSnapshotId   String?
  holdingId            String
  symbol               String
  changeType           String
  previousQuantity     Decimal? @db.Decimal(28, 8)
  currentQuantity      Decimal? @db.Decimal(28, 8)
  quantityChange       Decimal? @db.Decimal(28, 8)
  previousAveragePrice Decimal? @db.Decimal(28, 8)
  currentAveragePrice  Decimal? @db.Decimal(28, 8)
  previousMarketValue  Decimal? @db.Decimal(28, 8)
  currentMarketValue   Decimal? @db.Decimal(28, 8)
  detectedAt           DateTime @default(now())

  portfolioAccount PortfolioAccount        @relation(fields: [portfolioAccountId], references: [id], onDelete: Restrict)
  currentSnapshot  PortfolioDailySnapshot  @relation("CurrentDailySnapshotChanges", fields: [currentSnapshotId], references: [id], onDelete: Cascade)
  previousSnapshot PortfolioDailySnapshot? @relation("PreviousDailySnapshotChanges", fields: [previousSnapshotId], references: [id], onDelete: SetNull)
  holding          PortfolioHolding        @relation(fields: [holdingId], references: [id], onDelete: Restrict)

  @@unique([currentSnapshotId, holdingId])
  @@index([portfolioAccountId, detectedAt])
  @@index([changeType])
}

model PortfolioChangeAttribution {
  id                     String   @id @default(cuid())
  currentSnapshotId      String
  previousSnapshotId     String
  holdingId              String
  symbol                 String
  totalMarketValueChange Decimal  @db.Decimal(28, 8)
  quantityEffect         Decimal  @db.Decimal(28, 8)
  priceEffect            Decimal  @db.Decimal(28, 8)
  fxEffect               Decimal  @db.Decimal(28, 8)
  residualEffect         Decimal  @db.Decimal(28, 8)
  currency               String
  method                 String
  createdAt              DateTime @default(now())

  currentSnapshot  PortfolioDailySnapshot @relation("CurrentDailySnapshotEffects", fields: [currentSnapshotId], references: [id], onDelete: Cascade)
  previousSnapshot PortfolioDailySnapshot @relation("PreviousDailySnapshotEffects", fields: [previousSnapshotId], references: [id], onDelete: Restrict)
  holding          PortfolioHolding       @relation(fields: [holdingId], references: [id], onDelete: Restrict)

  @@unique([currentSnapshotId, holdingId])
  @@index([currentSnapshotId])
}

model PortfolioDailyBriefing {
  id                 String   @id @default(cuid())
  portfolioAccountId String
  snapshotId         String   @unique
  previousSnapshotId String?
  reportDate         DateTime @db.Date
  status             String
  headline           String
  summary            String
  changes            Json
  alerts             Json
  dataQuality        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  portfolioAccount PortfolioAccount        @relation(fields: [portfolioAccountId], references: [id], onDelete: Restrict)
  snapshot         PortfolioDailySnapshot  @relation("DailySnapshotBriefing", fields: [snapshotId], references: [id], onDelete: Cascade)
  previousSnapshot PortfolioDailySnapshot? @relation("PreviousDailySnapshotBriefings", fields: [previousSnapshotId], references: [id], onDelete: SetNull)

  @@index([portfolioAccountId, reportDate])
  @@index([status])
}

model DividendEvent {
  id             String    @id @default(cuid())
  market         String
  symbol         String
  dividendType   String
  amountPerShare Decimal?  @db.Decimal(28, 8)
  currency       String
  exDividendDate DateTime?
  recordDate     DateTime?
  paymentDate    DateTime?
  status         String
  sourceName     String?
  sourceUrl      String?
  dataQuality    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([market, symbol, exDividendDate])
  @@index([status])
}

model PortfolioNewsReference {
  id             String   @id @default(cuid())
  market         String
  symbol         String
  title          String
  sourceName     String
  url            String   @unique
  publishedAt    DateTime
  summary        String?
  riskCategory   String?
  relevanceScore Decimal? @db.Decimal(6, 5)
  collectedAt    DateTime @default(now())

  @@index([market, symbol, publishedAt])
  @@index([riskCategory])
}

model PortfolioRiskSignal {
  id                 String    @id @default(cuid())
  portfolioAccountId String
  holdingId          String?
  type               String
  severity           String
  title              String
  message            String
  detectedAt         DateTime  @default(now())
  resolvedAt         DateTime?

  portfolioAccount PortfolioAccount  @relation(fields: [portfolioAccountId], references: [id], onDelete: Restrict)
  holding          PortfolioHolding? @relation(fields: [holdingId], references: [id], onDelete: SetNull)

  @@index([portfolioAccountId, resolvedAt])
  @@index([holdingId])
  @@index([severity])
}

model PortfolioReport {
  id                 String   @id @default(cuid())
  portfolioAccountId String
  reportType         String
  reportDate         DateTime
  summary            String
  body               String
  dataQuality        String
  status             String
  createdAt          DateTime @default(now())

  portfolioAccount PortfolioAccount @relation(fields: [portfolioAccountId], references: [id], onDelete: Restrict)

  @@index([portfolioAccountId, reportDate])
  @@index([reportType, status])
}

// Phase 2-T.1 · internal paper trading only.
// These models are deliberately separate from read-only PortfolioAccount/Holding data.
model PaperTradingAccount {
  id                         String    @id @default(cuid())
  name                       String    @default("미국주식 모의계좌")
  mode                       String    @default("PAPER")
  externalOrderAuthorization String    @default("NONE")
  executionVenue             String    @default("INTERNAL_VIRTUAL_BROKER")
  baseCurrency               String    @default("KRW")
  initialCapitalKrw          Decimal   @db.Decimal(28, 8)
  cashKrw                    Decimal   @db.Decimal(28, 8)
  equityKrw                  Decimal   @db.Decimal(28, 8)
  realizedPnlKrw             Decimal   @default(0) @db.Decimal(28, 8)
  usdKrw                     Decimal?  @db.Decimal(18, 8)
  status                     String    @default("ACTIVE")
  strategyVersion            String
  rules                      Json
  lastMarketDate             DateTime? @db.Date
  lastRunAt                  DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  positions  PaperTradingPosition[]
  orders     PaperTradingOrder[]
  fills      PaperTradingFill[]
  trades     PaperTradingTrade[]
  signals    PaperTradingSignal[]
  snapshots  PaperTradingSnapshot[]
  riskEvents PaperTradingRiskEvent[]

  @@index([status])
  @@index([createdAt])
}

model PaperTradingPosition {
  id                 String    @id @default(cuid())
  accountId          String
  symbol             String
  name               String
  strategy           String
  strategyVersion    String
  quantity           Int
  entryDate          DateTime  @db.Date
  entryPriceUsd      Decimal   @db.Decimal(28, 8)
  lastPriceUsd       Decimal   @db.Decimal(28, 8)
  stopPriceUsd       Decimal   @db.Decimal(28, 8)
  targetPriceUsd     Decimal?  @db.Decimal(28, 8)
  highestCloseUsd    Decimal   @db.Decimal(28, 8)
  entryCommissionKrw Decimal   @default(0) @db.Decimal(28, 8)
  status             String    @default("OPEN")
  openedAt           DateTime  @default(now())
  closedAt           DateTime?
  updatedAt          DateTime  @updatedAt

  account PaperTradingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, symbol])
  @@index([accountId, status])
}

model PaperTradingSignal {
  id                 String   @id @default(cuid())
  accountId          String
  externalSignalId   String
  symbol             String
  name               String
  strategy           String
  strategyVersion    String
  signalDate         DateTime @db.Date
  referencePriceUsd  Decimal  @db.Decimal(28, 8)
  stopPriceUsd       Decimal  @db.Decimal(28, 8)
  targetPriceUsd     Decimal? @db.Decimal(28, 8)
  score              Decimal  @db.Decimal(12, 6)
  reasons            Json
  status             String
  decisionReason     String?
  processedAt        DateTime @default(now())

  account PaperTradingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, externalSignalId])
  @@index([accountId, signalDate])
  @@index([status])
}

model PaperTradingOrder {
  id                 String    @id @default(cuid())
  accountId          String
  signalId           String?
  idempotencyKey     String    @unique
  symbol             String
  side               String
  orderType          String
  status             String
  quantity           Int
  requestedPriceUsd  Decimal?  @db.Decimal(28, 8)
  filledPriceUsd     Decimal?  @db.Decimal(28, 8)
  decisionReason     String?
  marketDate         DateTime  @db.Date
  createdAt          DateTime  @default(now())
  filledAt           DateTime?

  account PaperTradingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  fills   PaperTradingFill[]

  @@index([accountId, marketDate])
  @@index([accountId, status])
}

model PaperTradingFill {
  id            String   @id @default(cuid())
  accountId     String
  orderId       String
  symbol        String
  side          String
  quantity      Int
  priceUsd      Decimal  @db.Decimal(28, 8)
  usdKrw        Decimal  @db.Decimal(18, 8)
  notionalKrw   Decimal  @db.Decimal(28, 8)
  commissionKrw Decimal  @db.Decimal(28, 8)
  slippageBps   Decimal  @db.Decimal(12, 6)
  filledAt      DateTime @default(now())

  account PaperTradingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  order   PaperTradingOrder   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([accountId, filledAt])
  @@index([orderId])
}

model PaperTradingTrade {
  id                 String   @id @default(cuid())
  accountId          String
  symbol             String
  name               String
  strategy           String
  strategyVersion    String
  quantity           Int
  entryDate          DateTime @db.Date
  entryPriceUsd      Decimal  @db.Decimal(28, 8)
  exitDate           DateTime @db.Date
  exitPriceUsd       Decimal  @db.Decimal(28, 8)
  exitReason         String
  grossPnlKrw        Decimal  @db.Decimal(28, 8)
  netPnlKrw          Decimal  @db.Decimal(28, 8)
  returnPercent      Decimal  @db.Decimal(12, 6)
  entryCommissionKrw Decimal  @db.Decimal(28, 8)
  exitCommissionKrw  Decimal  @db.Decimal(28, 8)
  createdAt          DateTime @default(now())

  account PaperTradingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, exitDate])
  @@index([symbol])
}

model PaperTradingSnapshot {
  id               String   @id @default(cuid())
  accountId        String
  marketDate       DateTime @db.Date
  cashKrw          Decimal  @db.Decimal(28, 8)
  marketValueKrw   Decimal  @db.Decimal(28, 8)
  equityKrw        Decimal  @db.Decimal(28, 8)
  realizedPnlKrw   Decimal  @db.Decimal(28, 8)
  unrealizedPnlKrw Decimal  @db.Decimal(28, 8)
  openPositions    Int
  usdKrw           Decimal  @db.Decimal(18, 8)
  capturedAt       DateTime @default(now())

  account PaperTradingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([accountId, marketDate])
  @@index([accountId, capturedAt])
}

model PaperTradingRiskEvent {
  id        String   @id @default(cuid())
  accountId String
  symbol    String?
  type      String
  severity  String
  message   String
  details   Json?
  createdAt DateTime @default(now())

  account PaperTradingAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([type])
}
