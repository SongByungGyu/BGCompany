FROM node:22-alpine
WORKDIR /app/apps/web
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
WORKDIR /app
COPY apps/web/src/lib/business-development ./apps/web/src/lib/business-development
COPY infrastructure/bg-company-v2/001_control_plane.sql ./infrastructure/bg-company-v2/001_control_plane.sql
USER node
WORKDIR /app/apps/web
CMD ["node", "--experimental-strip-types", "--test", "src/lib/business-development/policy.test.ts", "src/lib/business-development/queue.integration.test.ts"]
